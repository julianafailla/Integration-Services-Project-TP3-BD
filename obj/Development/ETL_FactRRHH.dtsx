    <DTS:Executable
      DTS:refId="Package\Retirar hechos sin legajo"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{DDD23A03-4C31-4256-864E-443C6B102F1B}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Retirar hechos sin legajo"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{3CF0A360-E0E1-4857-A307-C0EB98E1EF0C}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;IF EXISTS (&#xA;    SELECT SK_Vendedor FROM dbo.Fact_RRHH GROUP BY SK_Vendedor HAVING COUNT(*) &gt; 1&#xA;)&#xA;    THROW 51010, N'Fact_RRHH tiene mas de una fila para un vendedor.', 1;&#xA;&#xA;WITH Candidatos AS (&#xA;    SELECT v.Id_vendedor, e.legajo, e.sueldo, e.fecha_ingreso,&#xA;           COUNT(*) OVER (PARTITION BY v.Id_vendedor) AS PorVendedor,&#xA;           COUNT(*) OVER (PARTITION BY e.legajo) AS PorEmpleado&#xA;    FROM FacturacionVentas.dbo.Vendedores AS v&#xA;    INNER JOIN RecursosHumanos.dbo.Empleado AS e&#xA;        ON LTRIM(RTRIM(v.Nombre)) COLLATE Latin1_General_CI_AI&#xA;         = CONCAT(LTRIM(RTRIM(e.nombre)), ' ', LTRIM(RTRIM(e.apellido))) COLLATE Latin1_General_CI_AI&#xA;),&#xA;Correspondencias AS (&#xA;    SELECT Id_vendedor, legajo, sueldo, fecha_ingreso&#xA;    FROM Candidatos&#xA;    WHERE PorVendedor = 1 AND PorEmpleado = 1&#xA;),&#xA;Horas AS (&#xA;    SELECT ce.legajo, SUM(c.duracion_horas) AS Total&#xA;    FROM RecursosHumanos.dbo.CapacitacionXEmpleado AS ce&#xA;    INNER JOIN RecursosHumanos.dbo.Capacitacion AS c&#xA;        ON c.id_capacitacion = ce.id_capacitacion&#xA;    WHERE ce.resultado = 'Aprobado'&#xA;      AND c.fecha_inicio &lt;= CONVERT(date, GETDATE())&#xA;    GROUP BY ce.legajo&#xA;)&#xA;DELETE f&#xA;FROM dbo.Fact_RRHH AS f&#xA;INNER JOIN dbo.Dim_Vendedor AS d ON d.SK_Vendedor = f.SK_Vendedor&#xA;WHERE NOT EXISTS (SELECT 1 FROM Correspondencias AS m WHERE m.Id_vendedor = d.Id_vendedor);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
