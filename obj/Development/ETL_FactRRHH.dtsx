            <component
              refId="Package\Data Flow Task\OLE DB Source"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset">[dbo].[Dim_Vendedor]</property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH Candidatos AS (
    SELECT v.Id_vendedor, e.legajo, e.sueldo, e.fecha_ingreso,
           COUNT(*) OVER (PARTITION BY v.Id_vendedor) AS PorVendedor,
           COUNT(*) OVER (PARTITION BY e.legajo) AS PorEmpleado
    FROM FacturacionVentas.dbo.Vendedores AS v
    INNER JOIN RecursosHumanos.dbo.Empleado AS e
        ON LTRIM(RTRIM(v.Nombre)) COLLATE Latin1_General_CI_AI
         = CONCAT(LTRIM(RTRIM(e.nombre)), ' ', LTRIM(RTRIM(e.apellido))) COLLATE Latin1_General_CI_AI
),
Correspondencias AS (
    SELECT Id_vendedor, legajo, sueldo, fecha_ingreso
    FROM Candidatos
    WHERE PorVendedor = 1 AND PorEmpleado = 1
),
Horas AS (
    SELECT ce.legajo, SUM(c.duracion_horas) AS Total
    FROM RecursosHumanos.dbo.CapacitacionXEmpleado AS ce
    INNER JOIN RecursosHumanos.dbo.Capacitacion AS c
        ON c.id_capacitacion = ce.id_capacitacion
    WHERE ce.resultado = 'Aprobado'
      AND c.fecha_inicio &lt;= CONVERT(date, GETDATE())
    GROUP BY ce.legajo
)
SELECT d.SK_Vendedor, ISNULL(h.Total, 0) AS Total_Horas_Capacitacion,
    CAST(m.sueldo AS decimal(12,2)) AS Sueldo_Actual,
    DATEDIFF(YEAR, m.fecha_ingreso, hoy.Fecha)
      - CASE WHEN DATEADD(YEAR, DATEDIFF(YEAR, m.fecha_ingreso, hoy.Fecha), m.fecha_ingreso)
                    &gt; hoy.Fecha THEN 1 ELSE 0 END AS Antiguedad_Anios
FROM dbo.Dim_Vendedor AS d
INNER JOIN Correspondencias AS m ON m.Id_vendedor = d.Id_vendedor
LEFT JOIN Horas AS h ON h.legajo = m.legajo
CROSS JOIN (SELECT CONVERT(date, GETDATE()) AS Fecha) AS hoy;</property>
