        <SQLTask:SqlTaskData
          SQLTask:Connection="{63C31554-A53D-4E31-BB69-762DA76886A6}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;&#xA;BEGIN TRY&#xA;    BEGIN TRANSACTION;&#xA;&#xA;    DECLARE @LockResult int;&#xA;    EXEC @LockResult = sys.sp_getapplock&#xA;        @Resource = N'ETL_FactVentas',&#xA;        @LockMode = 'Exclusive',&#xA;        @LockOwner = 'Transaction',&#xA;        @LockTimeout = 10000;&#xA;    IF @LockResult &lt; 0&#xA;        THROW 51000, N'No se pudo obtener el bloqueo de la carga de ventas.', 1;&#xA;&#xA;    IF EXISTS (SELECT 1 FROM dbo.Dim_Promocion WHERE idPromocion = 0 AND Es_Promocion = 1)&#xA;        THROW 51001, N'El codigo 0 ya esta asignado a una promocion activa.', 1;&#xA;&#xA;    IF NOT EXISTS (SELECT 1 FROM dbo.Dim_Promocion WHERE idPromocion = 0)&#xA;        INSERT dbo.Dim_Promocion (idPromocion, Es_Promocion)&#xA;        VALUES (0, 0);&#xA;&#xA;    SELECT r.Factura AS NumeroFactura, r.Articulo,&#xA;           t.SK_Tiempo, p.SK_Producto, g.SK_Geografia, v.SK_Vendedor,&#xA;           pr.SK_Promocion, b.RubroAlternateKey,&#xA;           r.Unidades AS UnidadesVendidas, r.Importe AS ImporteTotal&#xA;    INTO #Ventas&#xA;    FROM FacturacionVentas.dbo.Registros_Facturas AS r&#xA;    LEFT JOIN FacturacionVentas.dbo.Facturas AS f ON f.Factura = r.Factura&#xA;    LEFT JOIN FacturacionVentas.dbo.Clientes AS c ON c.Id_cliente = f.Cliente&#xA;    LEFT JOIN dbo.Dim_Tiempo AS t ON t.Fecha = CONVERT(date, f.Fecha)&#xA;    LEFT JOIN dbo.Dim_Producto AS p ON p.Id_articulo = r.Articulo&#xA;    LEFT JOIN dbo.Dim_Geografia AS g ON g.Id_ciudad = c.Ciudad&#xA;    LEFT JOIN dbo.Dim_Vendedor AS v ON v.Id_vendedor = f.Vendedor&#xA;    LEFT JOIN dbo.DIm_Rubro AS b ON b.Id_Rubro = c.Rubro&#xA;    LEFT JOIN dbo.Dim_Promocion AS pr&#xA;        ON pr.idPromocion = COALESCE(r.idPromocion, 0)&#xA;        AND pr.Es_Promocion = CASE WHEN r.idPromocion IS NULL THEN 0 ELSE 1 END;&#xA;&#xA;    IF EXISTS (&#xA;        SELECT 1 FROM #Ventas&#xA;        WHERE SK_Tiempo IS NULL OR SK_Producto IS NULL OR SK_Geografia IS NULL&#xA;           OR SK_Vendedor IS NULL OR SK_Promocion IS NULL OR RubroAlternateKey IS NULL&#xA;           OR UnidadesVendidas IS NULL OR ImporteTotal IS NULL&#xA;    )&#xA;        THROW 51002, N'Hay renglones de venta con dimensiones o medidas faltantes.', 1;&#xA;&#xA;    CREATE UNIQUE CLUSTERED INDEX IX_Ventas ON #Ventas (NumeroFactura, Articulo);&#xA;&#xA;&#xA;    IF EXISTS (&#xA;        SELECT f.NumeroFactura, p.Id_articulo&#xA;        FROM dbo.Fact_Ventas AS f&#xA;        JOIN dbo.Dim_Producto AS p ON p.SK_Producto = f.SK_Producto&#xA;        GROUP BY f.NumeroFactura, p.Id_articulo&#xA;        HAVING COUNT(*) &gt; 1&#xA;    )&#xA;        THROW 51003, N'Fact_Ventas tiene renglones duplicados.', 1;&#xA;    COMMIT TRANSACTION;&#xA;END TRY&#xA;BEGIN CATCH&#xA;    IF XACT_STATE() &lt;&gt; 0 ROLLBACK TRANSACTION;&#xA;    THROW;&#xA;END CATCH;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
